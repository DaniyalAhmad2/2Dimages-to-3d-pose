# Local dev tooling — never part of the deliverable
.claude/
CLAUDE.md
.mcp.json
.cursor/
.aider*

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Virtual env / build / packaging artifacts
.venv/
wheelhouse/
build/
dist/
*.spec.bak

# uv: uv.lock is committed on purpose — CI installs from it, so the Windows
# build the client receives is built from exactly these versions.

# Third-party dataset downloads + derived artifacts (re-downloadable; see
# README_RUN.md). Small evidence files are force-added below.
data/hdVideos/
data/frames/
data/overlays/
data/hdPose3d/
data/hdPose3d.tar
data/calibration_*.json
data/demo_project/images/
data/demo_project/export/*.mp4

# The client guide's build: `npm install docx` in docs/client, and the
# rendered document. The source is content.json + build.js; the .docx/.pdf are
# outputs, re-rendered when the text changes, and a stale copy committed here
# is the very problem docs/client exists to remove.
docs/client/node_modules/
docs/client/package-lock.json
docs/client/Pose3D-Getting-Started.docx
docs/client/Pose3D-Getting-Started.pdf

# OS
.DS_Store

# Bundled binaries for the container image (large, not source)
docker/vendor/

# Client workspace created by docker compose (their data, not source)
workspace/

# Capture data / exports produced while testing (client data, large)
assets/*
!assets/checkerboard.md
pose3d-diagnostics.txt
pose3d-log.txt
