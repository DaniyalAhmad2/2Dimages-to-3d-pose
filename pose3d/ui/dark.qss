QWidget {
    background: #0d0f15;
    color: #e6e8ee;
    font-family: "Segoe UI", "DejaVu Sans", sans-serif;
    font-size: 13px;
}

/* top bar */
#topbar { background: #0a0c11; border-bottom: 1px solid #1e2230; }
#projectTitle { font-size: 14px; font-weight: 600; }
#savedLabel { color: #4ed67a; font-weight: 600; }

/* sidebar */
#sidebar { background: #0a0c11; border-right: 1px solid #1e2230; }
#sectionHeader { color: #6b7385; font-size: 10px; font-weight: 700; letter-spacing: 1.4px; }
#projectName { font-size: 15px; font-weight: 600; padding-bottom: 2px; }
#infoKey { color: #8a91a3; }
#infoVal { color: #d6dae4; font-weight: 500; }
#hintBox { background: #12151d; border: 1px solid #1e2230; border-radius: 8px;
           color: #8a91a3; padding: 10px; font-size: 12px; }

/* card panels (cameras, 3D, accuracy, etc.) */
#cardPanel { background: #0f1219; border: 1px solid #1e2230; border-radius: 10px; }
#panelTitle { color: #aeb4c2; font-size: 12px; font-weight: 700; letter-spacing: 1px; }
#fileLabel { color: #7f8698; font-size: 12px; }
#legendLabel { color: #aeb4c2; font-size: 11px; }

/* buttons */
QPushButton {
    background: #171b26; border: 1px solid #262b3a; border-radius: 7px; padding: 7px 13px;
}
QPushButton:hover { background: #212636; }
QPushButton:disabled { color: #4a505f; background: #12151d; border-color: #1a1e29; }
#primaryBtn:checked { background: #5257e6; border-color: #6d72ff; color: #ffffff; }
#actionRow { background: transparent; }

/* camera toolbar */
#camTool { background: #171b26; border: 1px solid #262b3a; border-radius: 6px;
           color: #cfd4e0; min-width: 26px; min-height: 26px; font-size: 14px; }
#camTool:hover { background: #262c3d; }

/* accuracy list */
#accuracyList { background: #0b0d13; border: 1px solid #1a1e29; border-radius: 6px;
                font-family: monospace; font-size: 12px; }
#accuracyList::item { padding: 1px 2px; }

/* combo boxes */
QComboBox { background: #171b26; border: 1px solid #262b3a; border-radius: 6px; padding: 3px 8px; }
QComboBox QAbstractItemView { background: #12151d; selection-background-color: #262c3d; }

/* checkboxes */
QCheckBox { spacing: 8px; color: #d6dae4; }

/* graphics + timeline */
QGraphicsView { background: #0b0d13; border: 1px solid #1a1e29; border-radius: 6px; }
QListView { background: #0b0d13; border: 1px solid #1a1e29; border-radius: 6px; }
/* splitters — the drag handles between the camera views, the 3D view and the
   accuracy column. Unstyled, Qt draws these from the system palette, so on a
   light-mode host they were invisible against the dark panels and there was no
   sign the panes could be resized at all. Give them a real edge, a comfortable
   grab width, and a hover colour so the affordance is discoverable. */
QSplitter::handle { background: #1e2230; }
QSplitter::handle:horizontal { width: 6px; margin: 0 1px; }
QSplitter::handle:vertical { height: 6px; margin: 1px 0; }
QSplitter::handle:hover { background: #3d7bfd; }
QSplitter::handle:pressed { background: #5a90ff; }

QScrollBar:horizontal { height: 10px; background: #0b0d13; }
QScrollBar::handle:horizontal { background: #262b3a; border-radius: 5px; min-width: 30px; }
QScrollBar:vertical { width: 10px; background: #0b0d13; }
QScrollBar::handle:vertical { background: #262b3a; border-radius: 5px; min-height: 30px; }
QStatusBar { background: #0a0c11; color: #8a91a3; border-top: 1px solid #1e2230; }

/* File pickers. The container has no desktop portal, so Qt's own dialog is
   what actually appears; style it to match the rest of the app. */
QFileDialog { background: #12141b; color: #dfe3ec; }
QFileDialog QWidget { background: #12141b; color: #dfe3ec; }
QFileDialog QListView, QFileDialog QTreeView,
QFileDialog QLineEdit, QFileDialog QComboBox {
    background: #1a1d26; color: #dfe3ec;
    border: 1px solid #2a2f3d; border-radius: 4px; padding: 2px 4px;
}
QFileDialog QListView::item:selected, QFileDialog QTreeView::item:selected {
    background: #2f6fd0; color: #ffffff;
}
QFileDialog QHeaderView::section {
    background: #1a1d26; color: #aeb4c2; border: 0; padding: 4px;
}
QFileDialog QPushButton, QFileDialog QToolButton {
    background: #232735; color: #dfe3ec;
    border: 1px solid #2f3545; border-radius: 4px; padding: 4px 10px;
}
QFileDialog QPushButton:hover, QFileDialog QToolButton:hover { background: #2c3242; }
